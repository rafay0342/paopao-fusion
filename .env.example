# Runtime
HOST=127.0.0.1
PORT=8189
PAOPAO_PUBLIC_ORIGIN=http://127.0.0.1:8189
PAOPAO_DATA_DIR=./data

# Generate unique production values; never commit the real secrets.
PAOPAO_SESSION_SECRET=replace-with-a-long-random-secret
PAOPAO_CONTENT_SECRET=replace-with-a-different-long-random-secret
PAOPAO_NATIVE_SECRET=replace-with-another-long-random-secret

# Email sign-in (SMTP is required outside explicit local development mode)
PAOPAO_SMTP_URL=smtps://username:password@smtp.example.com:465
PAOPAO_EMAIL_FROM=PaoPao Fusion <no-reply@example.com>
PAOPAO_ALLOW_DEV_OTP=0

# Google OAuth 2.0 web application
PAOPAO_GOOGLE_CLIENT_ID=
PAOPAO_GOOGLE_CLIENT_SECRET=

# Facebook Login application
PAOPAO_FACEBOOK_APP_ID=
PAOPAO_FACEBOOK_APP_SECRET=
