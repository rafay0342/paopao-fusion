{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paopao.local/schemas/ledger-evidence-claims-v1.json",
  "title": "PaoPao ledger acceptance evidence claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledgerSchemaVersion", "policy", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ledgerSchemaVersion": { "const": 3 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oneClaimPerItemTarget", "uniqueAssertionPerClaim", "exactTestCaseRequired", "sourceHashesRequired"],
      "properties": {
        "oneClaimPerItemTarget": { "const": true },
        "uniqueAssertionPerClaim": { "const": true },
        "exactTestCaseRequired": { "const": true },
        "sourceHashesRequired": { "const": true }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "assertionId", "itemId", "acceptanceId", "target", "implementationPaths", "test", "note"],
        "properties": {
          "claimId": { "pattern": "^EC-PF-[a-z-]+-[0-9]{3}-(shared|phaser)$" },
          "assertionId": { "pattern": "^AE-AT-PF-[a-z-]+-[0-9]{3}-(shared|phaser)$" },
          "itemId": { "pattern": "^PF-[a-z-]+-[0-9]{3}$" },
          "acceptanceId": { "pattern": "^AT-PF-[a-z-]+-[0-9]{3}$" },
          "target": { "enum": ["shared", "phaser"] },
          "implementationPaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "test": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "fullName"],
            "properties": {
              "path": { "pattern": "^tests/.+\\.test\\.[cm]?[jt]sx?$" },
              "fullName": { "type": "string", "minLength": 1 }
            }
          },
          "note": { "type": "string", "minLength": 24 }
        }
      }
    }
  }
}
