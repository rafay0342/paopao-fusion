{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paopao-fusion",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "assets": {
    "directory": "../dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paopao-fusion",
      "database_id": "f58c2cc2-9d28-44a5-b70e-a2beda93de9e",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME", "class_name": "RealtimeHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
